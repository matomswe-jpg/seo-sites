# Modèle générique. Copier dans sites/<domaine>/.env.local et remplir.
# Ne JAMAIS commiter le fichier .env.local.
WP_BASE_URL=https://exemple.com
# Identifiant du compte technique dédié (pas le compte administrateur principal)
WP_USER=
# Application Password créée dans Utilisateurs > Profil > Mots de passe d'application
WP_APP_PASSWORD=
